<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        fOCUS itself still declares NO permissions (Phases 1-8); the WorkManager
        library merges in a few normal install-time ones (to be checked on the built APK). Each later permission is added in the phase
        that needs it, with an in-app explanation (see README, "Permissions").
        Phase 6 adds none: emergency access only opens the phone's own dialer through an intent
        (the <queries> entry for DIAL already covers it), and PIN screens use FLAG_SECURE.
        Phase 5 adds no permission either: Do Not Disturb access is a special grant the
        person gives in system settings, and Device Owner status is given by provisioning.
        Shizuku support adds no permission either: the ShizukuProvider below only receives the
        connection from the Shizuku app, and the person must allow fOCUS inside Shizuku.
        Notably there is no INTERNET permission: fOCUS processes and stores
        everything locally.

        Package visibility (Android 11+): the <queries> below are not permissions. They
        declare which kinds of apps fOCUS may see: apps with a launcher entry, plus the
        intents used to recognise the home, phone, emergency and settings apps so they
        can be protected. QUERY_ALL_PACKAGES is deliberately NOT used.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.telephony.action.EMERGENCY_ASSISTANCE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_POLICY_ACCESS_SETTINGS" />
        </intent>
        <!-- Only to open the Shizuku app from the in-app guide. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".FocusApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FOCUS">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets Android make fOCUS the Device Owner during provisioning. It requests no
            device-admin policies and does nothing unless the device is provisioned that way.
        -->
        <receiver
            android:name=".device.FocusDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            Lets the Shizuku app hand fOCUS its connection. Not a permission request: the person
            still has to allow fOCUS inside Shizuku, and nothing happens without that.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
